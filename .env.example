# Copy to `.env` (already gitignored) and fill in.
# Loaded automatically by script/sweep/sweep_run.py and sweep_init.py.

# wandb destination for sweep runs. WANDB_ENTITY / WANDB_PROJECT are the
# canonical names the wandb SDK / CLI also read on its own.
WANDB_ENTITY=advanced-technology-department
WANDB_PROJECT=VAD-GS

# Optional: API key for headless machines / CI.
# WANDB_API_KEY=
